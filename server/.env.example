# 复制这个文件为项目根目录的 .env，然后把 Key 填进去。
# 讯飞开放平台控制台 → 星火认知大模型 → 服务接口认证信息 → APIPassword
#
# 星火 OpenAI 兼容接口（国内直连，不需要代理）
AI_BASE_URL=https://spark-api-open.xf-yun.com/v1/chat/completions
AI_API_KEY=你的APIPassword
# 可填控制台中开通的版本，例如 lite / generalv3.5 / 4.0Ultra / max-32k
AI_MODEL=4.0Ultra
PORT=8787

# 想让三个 NPC 各用各的账号（额度互不占用），就各自申请一个讯飞账号，
# 把 APIPassword 填在下面。名字要和 server/ai-config.json 里的 apiKeyEnv 对上。
# 不填的角色会自动用上面的 AI_API_KEY。
#AI_KEY_LAOBANZHANG=老班长的Key
#AI_KEY_SHITOU=石头的Key
#AI_KEY_HEXIUYING=何大姐的Key
