{
  "_说明": "使用云端 DeepSeek API；不同角色共享基础模型，通过独立人设和上下文交互。密钥只从服务端环境变量读取。",

  "default": {
    "baseUrl": "https://api.deepseek.com/v1/chat/completions",
    "apiKeyEnv": "AI_API_KEY",
    "model": "deepseek-chat",
    "temperature": 0.85,
    "maxTokens": 220
  },

  "characters": {
    "li-changhe": {
      "temperature": 0.65,
      "apiKeyEnv": "AI_KEY_LAOBANZHANG",
      "模型说明": "老班长话少、短句，温度调低一点更稳。"
    },
    "shitou": {
      "temperature": 1.0,
      "apiKeyEnv": "AI_KEY_SHITOU",
      "模型说明": "石头是个十六岁的孩子，温度调高一点，让他跳脱。"
    },
    "he-xiuying": {
      "temperature": 0.8,
      "apiKeyEnv": "AI_KEY_HEXIUYING",
      "模型说明": "何大姐冷静克制。"
    },
    "he-xiuying-old": {
      "temperature": 0.6
    }
  }
}
