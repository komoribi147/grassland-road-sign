{
  "id": "act2",
  "title": "第二幕 · 泥沼",
  "bg": "assets/bg/act2-morning-fog.jpg",
  "tone": ["#485147", "#1d231e"],
  "ambient": "",
  "present": ["li-changhe", "shitou", "he-xiuying"],
  "situation": "又一个清晨，大雾，队伍沿前人的脚印走。石头在泥沼边遇险，老班长、何大姐和你合力救他。老班长先前给了你一只草鞋，右脚一直光着。",
  "steps": [
    { "t": "visual", "description": "又一个清晨。雾很大，五步外看不清人。众人已经在草地里走了几天。", "visual": {"sheet":"assets/storyboards/sheet-06.jpg","panel":0} },
    { "t": "visual", "description": "队伍排成一列，踩着前面人的脚印走。老班长在最前面探路，每走一步，都要先用木棍戳几下。", "visual": {"sheet":"assets/storyboards/sheet-06.jpg","panel":1} },
    { "t": "say", "who": "li-changhe", "text": "跟着前面的脚印。看着是草，底下有的地方全是泥。别自己找近路。" },
    { "t": "bg", "src": "assets/bg/act2-bog.jpg", "tone": ["#3a423a", "#0e1310"] },
    { "t": "visual", "description": "突然——", "visual": {"sheet":"assets/storyboards/sheet-06.jpg","panel":2} , "after": [{ "t": "sfx", "name": "thump", "level": 0.5 }]},
    { "t": "say", "who": "shitou", "text": "啊——！" },
    { "t": "visual", "description": "画面猛转。石头陷进泥沼，泥水已经没到腰。他拼命挣扎，越挣扎陷得越快。", "visual": {"sheet":"assets/storyboards/sheet-06.jpg","panel":3} },
    { "t": "sfx", "name": "splash" },
    { "t": "say", "who": "shitou", "text": "老班长！老班长——！" },
    { "t": "say", "who": "li-changhe", "text": "别动！石头！别动！" },
    { "t": "visual", "description": "老班长转身往回跑，泥水溅了一脸。", "visual": {"sheet":"assets/storyboards/sheet-06.jpg","panel":4} , "after": [{ "t": "sfx", "name": "run-splash", "level": 0.5 }]},
    { "t": "say", "who": "he-xiuying", "text": "先站稳！老李，把木棍递给他。" },
    { "t": "action", "label": "把木棍递过去", "visual": {"sheet":"assets/storyboards/sheet-06.jpg","panel":5}, "hint": "等大家站稳，一起拉" , "after": [{ "t": "sfx", "name": "wood-knock", "level": 0.5 }]},
    { "t": "action", "label": "抓住绑腿布", "visual": {"sheet":"assets/storyboards/sheet-07.jpg","panel":0}, "hint": "抓牢，等何大姐过来" , "after": [{ "t": "sfx", "name": "cloth-strain", "level": 0.5 }]},
    { "t": "visual", "description": "何大姐扶住老班长，站在一块较实的草甸上，和你一同握紧绑腿布。", "visual": {"sheet":"assets/storyboards/sheet-07.jpg","panel":1} },
    { "t": "say", "who": "li-changhe", "text": "石头，抓稳。听我数，一、二、三！" },
    { "t": "action", "label": "和大家一起拉", "visual": {"sheet":"assets/storyboards/sheet-07.jpg","panel":2}, "hint": "一起用力" , "after": [{ "t": "sfx", "name": "mud-churn", "level": 0.6 }]},
    { "t": "visual", "description": "老班长把绑腿布甩给石头，他自己一只脚已经踩进泥里。", "visual": {"sheet":"assets/storyboards/sheet-07.jpg","panel":3} },
    { "t": "say", "who": "he-xiuying", "text": "老李！你脚底下在往下陷！" },
    { "t": "say", "who": "he-xiuying", "text": "石头抓牢！老李，把手给我。两个都得上来。" },
    { "t": "visual", "description": "石头被拉上来了。满身黑泥，浑身发抖，军号死死攥在手里。", "visual": {"sheet":"assets/storyboards/sheet-07.jpg","panel":4} , "after": [{ "t": "sfx", "name": "pant", "level": 0.5 }]},
    { "t": "visual", "description": "老班长也被拉回实地。先前让出草鞋的右脚被硬石划破，泥水顺着伤口流下来。", "visual": {"sheet":"assets/storyboards/sheet-07.jpg","panel":5} },
    { "t": "trust", "delta": 15, "why": "一起把石头拉了上来" },
    { "t": "say", "who": "he-xiuying", "text": "老李！你脚——" },
    { "t": "say", "who": "li-changhe", "text": "皮外伤。走。" },
    { "t": "visual", "description": "何大姐已经蹲下来，打开了药箱。", "visual": {"sheet":"assets/storyboards/sheet-08.jpg","panel":0} },
    { "t": "say", "who": "he-xiuying", "text": "坐下。" },
    { "t": "say", "who": "li-changhe", "text": "何大姐，队伍——" },
    { "t": "say", "who": "he-xiuying", "text": "你这脚若走不了，后面的人也得停。让我看。" },
    { "t": "visual", "description": "她用仅剩的一点碘酒给伤口消毒，然后撕下自己衣服的一角包扎。", "visual": {"sheet":"assets/storyboards/sheet-08.jpg","panel":1} },
    { "t": "say", "who": "he-xiuying", "text": "伤口先包住。到干处再换一回布。" },
    { "t": "say", "who": "li-changhe", "text": "这地方，哪儿有干处？" },
    { "t": "visual", "description": "（何大姐站起来，看着他。）", "visual": {"sheet":"assets/storyboards/sheet-08.jpg","panel":2} },
    { "t": "say", "who": "he-xiuying", "text": "那就找一处。你先坐稳。" },
    { "t": "visual", "description": "（她转身，声音低了一点。）", "visual": {"sheet":"assets/storyboards/sheet-08.jpg","panel":3} },
    { "t": "say", "who": "he-xiuying", "text": "老李。你那口锅，还背得动吗？" },
    { "t": "say", "who": "li-changhe", "text": "背得动。" },
    { "t": "say", "who": "he-xiuying", "text": "那你背着。我扶着伤员。" },
    { "t": "say", "who": "shitou", "text": "老班长，我不该离开脚印。还害你伤了脚。" },
    { "t": "visual", "description": "（老班长摸了摸他的头。）", "visual": {"sheet":"assets/storyboards/sheet-08.jpg","panel":4} },
    { "t": "say", "who": "li-changhe", "text": "离了脚印，下回要告诉大家。刚才你喊得对，我们才听见。" },
    { "t": "say", "who": "shitou", "text": "嗯。我跟紧你们。" },
    { "t": "say", "who": "li-changhe", "text": "还有——后面的人，看着我们的脚印走。你刚才踩的那个地方，插根棍子，做个记号。" },
    { "t": "action", "label": "在泥沼边插一根木棍", "visual": {"sheet":"assets/storyboards/sheet-08.jpg","panel":5}, "hint": "再把红布绑上去", "trust": 5, "why": "给后面的人留了记号" , "after": [{ "t": "sfx", "name": "stick-mud", "level": 0.5 }]},
    { "t": "visual", "description": "木棍上绑着一条红布——那是老班长从自己衣服上撕下来的。\n红布在雾里，是今天唯一能看清的颜色。", "visual": {"sheet":"assets/storyboards/sheet-09.jpg","panel":0} },
    { "t": "lore", "card": "lubiao" },
    { "t": "visual", "description": "何大姐在被踩散的粮袋旁捡起几颗青稞粒，拣去泥草，收进小布袋，打算到了营地洗净煮熟。", "visual": {"sheet":"assets/storyboards/sheet-09.jpg","panel":1} },
    { "t": "say", "who": "shitou", "text": "何大姐，你捡这个干啥？" },
    { "t": "say", "who": "he-xiuying", "text": "收好。洗净煮熟，给伤员添一口。" },
    { "t": "say", "who": "shitou", "text": "就这几颗……" },
    { "t": "say", "who": "he-xiuying", "text": "就这几颗，也是粮食。" },
    { "t": "lore", "card": "nvhongjun" },
    { "t": "goto", "scene": "act3" }
  ]
}
