{
  "id": "act2",
  "title": "第二幕 · 泥沼",
  "bg": "assets/bg/act2-morning-fog.jpg",
  "tone": ["#485147", "#1d231e"],
  "ambient": "",
  "present": ["li-changhe", "shitou", "he-xiuying"],
  "situation": "第二天清晨，大雾，队伍踩着脚印走。刚刚把陷进泥沼的石头拉上来，老班长的脚被划开了一道口子，何大姐正在给他包扎。",
  "steps": [
    { "t": "narrate", "text": "第二天清晨。草地。雾很大，五步外看不见人。" },
    { "t": "narrate", "text": "队伍排成一列，踩着前面人的脚印走。老班长在最前面探路，每走一步，都要先用木棍戳几下。" },
    { "t": "say", "who": "li-changhe", "text": "看着我的脚印。一步都不能偏。这草地，看着是草，下面是水，再下面是泥。踩错一步，人就没了。" },
    { "t": "bg", "src": "assets/bg/act2-bog.jpg", "tone": ["#3a423a", "#0e1310"] },
    { "t": "narrate", "text": "突然——" , "after": [{ "t": "sfx", "name": "thump", "level": 0.5 }]},
    { "t": "say", "who": "shitou", "text": "啊——！" },
    { "t": "narrate", "text": "画面猛转。石头陷进泥沼，泥水已经没到腰。他拼命挣扎，越挣扎陷得越快。" },
    { "t": "sfx", "name": "splash" },
    { "t": "say", "who": "shitou", "text": "老班长！老班长——！" },
    { "t": "say", "who": "li-changhe", "text": "别动！石头！别动！" },
    { "t": "narrate", "text": "老班长转身往回跑，泥水溅了一脸。" , "after": [{ "t": "sfx", "name": "run-splash", "level": 0.5 }]},
    { "t": "say", "who": "li-changhe", "text": "把枪横过来！横着！趴下！" },
    { "t": "action", "label": "把木棍递过去", "hint": "别停，连着点" , "after": [{ "t": "sfx", "name": "wood-knock", "level": 0.5 }]},
    { "t": "action", "label": "抓住他的绑腿", "hint": "别松手" , "after": [{ "t": "sfx", "name": "cloth-strain", "level": 0.5 }]},
    { "t": "narrate", "text": "何大姐从另一边扑过来，一把抓住石头的胳膊。" },
    { "t": "action", "label": "和何大姐一起拽", "hint": "最后一下" , "after": [{ "t": "sfx", "name": "mud-churn", "level": 0.6 }]},
    { "t": "say", "who": "li-changhe", "text": "拽！别松手！我喊一二三——" },
    { "t": "narrate", "text": "老班长把绑腿布甩给石头，他自己一只脚已经踩进泥里。" },
    { "t": "say", "who": "he-xiuying", "text": "老李！你脚底下在往下陷！" },
    { "t": "say", "who": "li-changhe", "text": "别管我！先拉他！" },
    { "t": "narrate", "text": "石头被拉上来了。满身黑泥，浑身发抖，军号死死攥在手里。" , "after": [{ "t": "sfx", "name": "pant", "level": 0.5 }]},
    { "t": "narrate", "text": "老班长的左腿陷到膝盖。他自己爬出来的时候，那只光着的脚被泥里的什么东西划开一道大口子，血混着黑泥往下淌。" },
    { "t": "trust", "delta": 15, "why": "一起把石头拉了上来" },
    { "t": "say", "who": "he-xiuying", "text": "老李！你脚——" },
    { "t": "say", "who": "li-changhe", "text": "皮外伤。走。" },
    { "t": "narrate", "text": "何大姐已经蹲下来，打开了药箱。" },
    { "t": "say", "who": "he-xiuying", "text": "坐下。" },
    { "t": "say", "who": "li-changhe", "text": "何大姐，队伍——" },
    { "t": "say", "who": "he-xiuying", "text": "坐下。你走不了，谁都走不了。" },
    { "t": "narrate", "text": "她用仅剩的一点碘酒给伤口消毒，然后撕下自己衣服的一角包扎。" },
    { "t": "say", "who": "he-xiuying", "text": "三天之内不能沾水。" },
    { "t": "say", "who": "li-changhe", "text": "这地方，三天不沾水？" },
    { "t": "narrate", "text": "（何大姐站起来，看着他。）" },
    { "t": "say", "who": "he-xiuying", "text": "那就别把脚往泥里踩。" },
    { "t": "narrate", "text": "（她转身，声音低了一点。）" },
    { "t": "say", "who": "he-xiuying", "text": "老李。你那口锅，还背得动吗？" },
    { "t": "say", "who": "li-changhe", "text": "背得动。" },
    { "t": "say", "who": "he-xiuying", "text": "那你背着。我扶着伤员。" },
    { "t": "say", "who": "shitou", "text": "老班长，我对不起……我不该喊……" },
    { "t": "narrate", "text": "（老班长摸了摸他的头。）" },
    { "t": "say", "who": "li-changhe", "text": "喊得对。不喊，你就没了。记住——陷进去了别慌，把枪横过来，趴下，等同志来拉你。记住没有？" },
    { "t": "say", "who": "shitou", "text": "记住了。" },
    { "t": "say", "who": "li-changhe", "text": "还有——后面的人，看着我们的脚印走。你刚才踩的那个地方，插根棍子，做个记号。" },
    { "t": "action", "label": "在泥沼边插一根木棍", "hint": "再把红布绑上去", "trust": 5, "why": "给后面的人留了记号" , "after": [{ "t": "sfx", "name": "stick-mud", "level": 0.5 }]},
    { "t": "narrate", "text": "木棍上绑着一条红布——那是老班长从自己衣服上撕下来的。\n红布在雾里，是今天唯一能看清的颜色。" },
    { "t": "lore", "card": "lubiao" },
    { "t": "narrate", "text": "何大姐在沼泽边蹲下来，从泥里捡起几颗麦粒——是之前过路的部队掉的。她把它们放在手心里，仔细地挑出能吃的，装进一个小布袋。" },
    { "t": "say", "who": "shitou", "text": "何大姐，你捡这个干啥？" },
    { "t": "say", "who": "he-xiuying", "text": "伤员明天得吃东西。" },
    { "t": "say", "who": "shitou", "text": "就这几颗……" },
    { "t": "say", "who": "he-xiuying", "text": "就这几颗，也是粮食。" },
    { "t": "lore", "card": "nvhongjun" },
    { "t": "goto", "scene": "act3" }
  ]
}
