{
  "id": "act4",
  "title": "第四幕 · 黎明",
  "bg": "assets/stills/dawn-meadow-bg.png",
  "tone": ["#5a5a4a", "#1a1d17"],
  "ambient": "",
  "present": ["shitou", "he-xiuying"],
  "situation": "行军数日后的黎明，众人看见班佑河，终于接近草地边缘。老班长昨夜守着来路，把油布留给发烧的伤员；此刻他没有跟上。",
  "steps": [
    { "t": "visual", "description": "又一个黎明。雨停了，天边渐渐亮起来。", "visual": {"src":"assets/stills/dawn-first-light.png"} },
    { "t": "visual", "description": "你醒来，发现自己身上盖着老班长那件破棉袄。\n老班长不在旁边。", "visual": {"src":"assets/stills/dawn-coat-pov.png"} },
    { "t": "say", "who": "shitou", "text": "河！河——！看到河了——！" , "after": [{ "t": "sfx", "name": "bird", "level": 0.50 }]},
    { "t": "visual", "description": "远处一条河在晨光中发亮。那是班佑河；过了这一带，才有机会赶上前队。", "visual": {"src":"assets/stills/dawn-banyu-river.png"} },
    { "t": "lore", "card": "bangyou" },
    { "t": "say", "who": "he-xiuying", "text": "班佑就在前面。快到了。" },
    { "t": "visual", "description": "伤员撑着棍子站起来。石头一边哭一边笑，吹响了军号。", "visual": {"src":"assets/stills/dawn-bugle.png"} },
    { "t": "sfx", "name": "bugle" },
    { "t": "say", "who": "__player__", "text": "老班长呢？" },
    { "t": "visual", "description": "石头愣住。何大姐愣住。所有人回头。", "visual": {"src":"assets/stills/dawn-turn-back.png"} },
    { "t": "bg", "src": "assets/stills/last-signpost-wide-bg.png", "tone": ["#4c5044", "#14170f"] },
    { "t": "visual", "description": "镜头回到来路。几十步外的高草甸上，老班长坐着，面向雾里，手里还握着绑红布的木棍。", "visual": {"src":"assets/stills/cook-sits-at-last-signpost.png"} , "after": [{ "t": "sfx", "name": "thump", "level": 0.45 }]},
    { "t": "say", "who": "shitou", "text": "老班长！你看见河没有？" },
    { "t": "say", "who": "shitou", "text": "老班长……？" },
    { "t": "action", "label": "走近老班长", "visual": {"src":"assets/stills/approach-last-signpost.png"}, "hint": "走得慢一点" , "after": [{ "t": "sfx", "name": "grass-steps", "level": 0.45 }]},
    { "t": "visual", "description": "他的两只脚都光着：右脚那只草鞋在你脚上，左脚那只早已磨断了绳。", "visual": {"src":"assets/stills/cook-both-feet-bare.png"} },
    { "t": "say", "who": "he-xiuying", "text": "昨夜他把油布留给伤员，自己守在这里。我说来换他，他让我先歇。" },
    { "t": "visual", "description": "何大姐蹲下，打开药箱，手停在最后一卷绷带上。她轻轻合上箱盖。", "visual": {"src":"assets/stills/medic-last-bandage.png"} },
    { "t": "say", "who": "shitou", "text": "老班长，我们看见河了。" },
    { "t": "say", "who": "he-xiuying", "text": "把那根木棍插在他身旁。后面的人还能看见。" },
    { "t": "action", "label": "把红布路标插稳", "visual": {"src":"assets/stills/secure-last-marker.png"}, "hint": "留给后面的人", "after": [{ "t": "sfx", "name": "stick-mud", "level": 0.4 }] },
    { "t": "say", "who": "shitou", "text": "我扶着老田。咱们接着走。" },
    { "t": "goto", "scene": "epilogue" }
  ]
}
