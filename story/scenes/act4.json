{
  "id": "act4",
  "title": "第四幕 · 黎明",
  "bg": "assets/bg/act4-dawn-river.jpg",
  "tone": ["#5a5a4a", "#1a1d17"],
  "ambient": "",
  "present": ["shitou", "he-xiuying"],
  "situation": "第四天清晨，雨停了，你们终于走出草地，看到了班佑河。老班长没有跟上来。",
  "steps": [
    { "t": "visual", "description": "第四天清晨。雨停了。天边有一道亮光。", "visual": {"sheet":"assets/storyboards/sheet-12.jpg","panel":5} },
    { "t": "visual", "description": "你醒来，发现自己身上盖着老班长那件破棉袄。\n老班长不在旁边。", "visual": {"sheet":"assets/storyboards/sheet-13.jpg","panel":0} },
    { "t": "say", "who": "shitou", "text": "河！河——！看到河了——！" , "after": [{ "t": "sfx", "name": "bird", "level": 0.50 }]},
    { "t": "visual", "description": "画面拉远。前方，草地尽头，一条河在晨光中发亮。班佑河。", "visual": {"sheet":"assets/storyboards/sheet-13.jpg","panel":1} },
    { "t": "lore", "card": "bangyou" },
    { "t": "say", "who": "he-xiuying", "text": "走出去了……我们走出去了……" },
    { "t": "visual", "description": "伤员撑着棍子站起来。石头一边哭一边笑，吹响了军号。", "visual": {"sheet":"assets/storyboards/sheet-13.jpg","panel":2} },
    { "t": "sfx", "name": "bugle" },
    { "t": "say", "who": "__player__", "text": "老班长呢？" },
    { "t": "visual", "description": "石头愣住。何大姐愣住。所有人回头。", "visual": {"sheet":"assets/storyboards/sheet-13.jpg","panel":3} },
    { "t": "bg", "src": "assets/bg/act4-signpost.jpg", "tone": ["#4c5044", "#14170f"] },
    { "t": "visual", "description": "画面慢慢摇回去。\n身后那片草地上，雨后的水洼映着天光。几十步外，一块稍微高一点的草甸子上，老班长坐在那里。背对着你们，面朝来路。像路标一样。", "visual": {"sheet":"assets/storyboards/sheet-13.jpg","panel":4} , "after": [{ "t": "sfx", "name": "thump", "level": 0.45 }]},
    { "t": "say", "who": "shitou", "text": "老班长！老班长！我们走出去了！看到河了！" },
    { "t": "say", "who": "shitou", "text": "老班长……？" },
    { "t": "action", "label": "走近老班长", "visual": {"sheet":"assets/storyboards/sheet-14.jpg","panel":1}, "hint": "走得慢一点" , "after": [{ "t": "sfx", "name": "grass-steps", "level": 0.45 }]},
    { "t": "visual", "description": "画面不给正脸。\n你只看见他的脚——两只脚都光着。那只草鞋，穿在你脚上。", "visual": {"sheet":"assets/storyboards/sheet-14.jpg","panel":2} },
    { "t": "say", "who": "he-xiuying", "text": "他……他昨晚把油布全盖伤员身上了。他自己……坐在这儿，说眯一会儿……" },
    { "t": "visual", "description": "（沉默。雨后的草地很安静，只有风声。）", "visual": {"sheet":"assets/storyboards/sheet-14.jpg","panel":3} },
    { "t": "visual", "description": "何大姐蹲下来，从药箱里拿出最后一块绷带。手停住了。然后她把绷带放回去，只是轻轻把它按平。", "visual": {"sheet":"assets/storyboards/sheet-14.jpg","panel":4}, "draft": true },
    { "t": "goto", "scene": "epilogue" }
  ]
}
